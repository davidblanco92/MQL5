generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id          String      @id @default(cuid())
  name        String
  description String?
  owner       User        @relation(fields: [ownerId], references: [id])
  ownerId     String
  files       SourceFile[]
  builds      Build[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model SourceFile {
  id        String   @id @default(cuid())
  name      String
  content   String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
}

model Build {
  id        String      @id @default(cuid())
  status    BuildStatus @default(QUEUED)
  output    String?
  artifact  String?
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}
